{
  "name": "landify-base",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "build-storybook": "storybook build",
    "dev": "nuxt dev",
    "format": "prettier --write --ignore-unknown \"{.storybook,.vscode,app,docs/architecture,playground,shared,stories}/**/*\" \"*.{js,mjs,ts,vue,json,yaml,yml,css}\"",
    "format:check": "prettier --check --ignore-unknown \"{.storybook,.vscode,app,docs/architecture,playground,shared,stories}/**/*\" \"*.{js,mjs,ts,vue,json,yaml,yml,css}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "nuxt prepare",
    "storybook": "storybook dev -p 6006",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@lucide/vue": "^1.33.0",
    "@tailwindcss/vite": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.15.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/vue3-vite": "^10.5.10",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "nuxt": "^4.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "storybook": "^10.5.10",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.4"
  }
}
